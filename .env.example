# Local development: copy to .env. Docker: the same file is read by compose.yaml (env_file),
# which itself sets NODE_ENV, HOST, PORT, DATABASE_PATH and the bootstrap password file.

# Public origin users open. Production must be https://… and match the reverse proxy.
APP_URL=http://127.0.0.1:5173
PORT=3000
DATABASE_PATH=data/gdg.sqlite
# Generate at least 32 random characters (e.g. `openssl rand -hex 32`); never commit the real secret.
BETTER_AUTH_SECRET=
# Required in production for invitation and password emails (verified sender domain).
RESEND_API_KEY=
MAIL_FROM=
# First president, created once on an empty database (npm run bootstrap, or automatically by the container).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD_FILE=secrets/bootstrap-password.txt
# Docker only: host port bound on 127.0.0.1 for the reverse proxy (default 3000).
# APP_PORT=3000
