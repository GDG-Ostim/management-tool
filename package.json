{
  "name": "gdg-management-tool",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "context": "node scripts/context.mjs",
    "vault:index": "node scripts/vault.mjs index",
    "vault:check": "node scripts/vault.mjs check",
    "hooks:install": "node scripts/setup-hooks.mjs",
    "test:tooling": "node --test scripts/vault.test.mjs",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "dev:web": "npm run dev -w @gdg/web",
    "bootstrap": "node --env-file-if-exists=.env --import tsx apps/api/src/bootstrap-cli.ts",
    "build": "npm run typecheck && npm run build -w @gdg/api && npm run build -w @gdg/web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env apps/api/dist/start.js",
    "backup": "node --env-file-if-exists=.env --import tsx apps/api/src/backup-cli.ts",
    "push:keys": "node scripts/push-keys.mjs",
    "restore": "node --env-file-if-exists=.env --import tsx apps/api/src/restore-cli.ts",
    "test": "npm run test:tooling && npm run test -w @gdg/api",
    "test:e2e": "npm run build -w @gdg/web && playwright test -c e2e/playwright.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
